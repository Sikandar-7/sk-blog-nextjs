---
const year = new Date().getFullYear();
const portfolio = 'https://portfolio-five-black-18.vercel.app';
---

<footer class="mt-24 border-t border-border">
  <div class="mx-auto max-w-6xl px-5 py-12">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-start sm:justify-between">
      <div class="max-w-sm">
        <a href="/" class="font-display text-lg font-extrabold tracking-tight">
          SK<span class="text-primary">.</span>Blog
        </a>
        <p class="mt-3 text-sm leading-relaxed text-muted">
          Notes on building for the web — what worked, what broke, and what I
          would do differently next time.
        </p>
      </div>

      <div class="flex gap-12">
        <div>
          <h2 class="mb-3 text-xs font-bold uppercase tracking-widest text-muted">
            Explore
          </h2>
          <ul class="space-y-2 text-sm">
            <li><a class="text-muted transition-colors hover:text-fg" href="/blog">Articles</a></li>
            <li><a class="text-muted transition-colors hover:text-fg" href="/about">About</a></li>
            <li><a class="text-muted transition-colors hover:text-fg" href="/rss.xml">RSS</a></li>
          </ul>
        </div>

        <div>
          <h2 class="mb-3 text-xs font-bold uppercase tracking-widest text-muted">
            Elsewhere
          </h2>
          <ul class="space-y-2 text-sm">
            <li>
              <a
                class="text-muted transition-colors hover:text-fg"
                href={portfolio}
                target="_blank"
                rel="noopener noreferrer">Portfolio</a
              >
            </li>
            <li>
              <a
                class="text-muted transition-colors hover:text-fg"
                href="https://github.com/Sikandar-7"
                target="_blank"
                rel="noopener noreferrer">GitHub</a
              >
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div
      class="mt-10 flex flex-col items-center justify-between gap-3 border-t border-border pt-6 text-xs text-muted sm:flex-row"
    >
      <p>© {year} SK Blog. All rights reserved.</p>
      <p>
        Built by{' '}
        <a
          href={portfolio}
          target="_blank"
          rel="noopener noreferrer"
          class="font-semibold text-primary transition-colors hover:text-fg"
          >Quantum Labs</a
        >
      </p>
    </div>
  </div>
</footer>
