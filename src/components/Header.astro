---
const links = [
  { href: '/', label: 'Home' },
  { href: '/blog', label: 'Articles' },
  { href: '/about', label: 'About' },
  { href: '/write', label: 'Write' },
  { href: '/admin', label: 'Admin' },
];
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header
  class="sticky top-0 z-50 border-b border-border/70 bg-bg/70 backdrop-blur-xl supports-[backdrop-filter]:bg-bg/60"
>
  <nav
    class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5"
    aria-label="Main"
  >
    <a
      href="/"
      class="group flex items-center gap-2 font-display text-lg font-extrabold tracking-tight"
    >
      <span
        class="grid h-8 w-8 place-items-center rounded-lg bg-primary text-sm font-black text-white transition-transform duration-300 group-hover:-rotate-6"
        >SK</span
      >
      <span class="hidden sm:inline">Blog</span>
    </a>

    <div class="flex items-center gap-1">
      {
        links.map((l) => (
          <a
            href={l.href}
            aria-current={isActive(l.href) ? 'page' : undefined}
            class:list={[
              'relative rounded-lg px-3 py-2 text-sm font-medium transition-colors',
              isActive(l.href)
                ? 'text-fg'
                : 'text-muted hover:text-fg',
            ]}
          >
            {l.label}
            {isActive(l.href) && (
              <span class="absolute inset-x-3 -bottom-px h-px bg-primary" />
            )}
          </a>
        ))
      }

      <button
        id="theme-toggle"
        type="button"
        class="ml-1 grid h-9 w-9 place-items-center rounded-lg border border-border text-muted transition-colors hover:border-primary hover:text-fg"
        aria-label="Toggle colour theme"
      >
        <svg
          class="h-4 w-4 dark-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg
          class="hidden h-4 w-4 light-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
        </svg>
      </button>
    </div>
  </nav>
</header>

<script is:inline>
  (() => {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;

    const sync = () => {
      const isLight = document.documentElement.dataset.theme === 'light';
      btn.querySelector('.dark-icon')?.classList.toggle('hidden', isLight);
      btn.querySelector('.light-icon')?.classList.toggle('hidden', !isLight);
    };

    btn.addEventListener('click', () => {
      const next =
        document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        /* ignore */
      }
      sync();
    });

    sync();
  })();
</script>
