---
import BaseLayout from '../layouts/BaseLayout.astro';
import Dashboard from '../components/islands/Dashboard.tsx';
---

<BaseLayout
  title="Your articles"
  description="Manage the articles you have written on SK Blog."
  noindex={true}
>
  <section class="mx-auto w-full max-w-3xl px-6 py-16 sm:py-20">
    <div class="mb-8">
      <p class="mb-3 text-xs font-bold uppercase tracking-[0.2em] text-primary">Dashboard</p>
      <h1 class="font-display text-4xl font-extrabold tracking-tight">Your articles</h1>
    </div>

    <Dashboard client:load />
  </section>
</BaseLayout>
