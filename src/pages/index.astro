---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPublishedPosts, getCategories } from '../lib/posts';

const posts = await getPublishedPosts();
const [featured, ...rest] = posts;
const recent = rest.slice(0, 4);
const categories = await getCategories();
---

<BaseLayout title="SK Blog">
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-border">
    <div
      class="pointer-events-none absolute -top-40 left-1/2 h-80 w-[42rem] -translate-x-1/2 rounded-full bg-primary/20 blur-[120px]"
      aria-hidden="true"
    >
    </div>

    <div class="relative mx-auto max-w-6xl px-5 py-20 sm:py-28">
      <p
        class="animate-fade-in mb-5 inline-flex items-center gap-2 rounded-full border border-border bg-surface px-3 py-1.5 text-xs font-semibold uppercase tracking-widest text-muted"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-secondary"></span>
        Writing on web development
      </p>

      <h1
        class="animate-fade-up font-display text-5xl font-extrabold leading-[1.05] tracking-tighter sm:text-6xl lg:text-7xl"
      >
        Build it.<br />
        Break it.<br />
        <span class="text-primary">Write it down.</span>
      </h1>

      <p class="animate-fade-up mt-7 max-w-xl text-lg leading-relaxed text-muted">
        Notes from actually shipping software — the bugs that cost me a weekend,
        the decisions I would make differently, and the things nobody warns you
        about.
      </p>

      <div class="animate-fade-up mt-9 flex flex-wrap gap-3">
        <a
          href="/blog"
          class="rounded-xl bg-primary px-6 py-3 text-sm font-bold text-white transition-transform duration-200 hover:-translate-y-0.5"
          >Read the articles</a
        >
        <a
          href="/about"
          class="rounded-xl border border-border px-6 py-3 text-sm font-bold text-fg transition-colors hover:border-primary"
          >About me</a
        >
      </div>
    </div>
  </section>

  {
    posts.length === 0 ? (
      <section class="mx-auto max-w-6xl px-5 py-24 text-center">
        <p class="text-5xl">✍️</p>
        <h2 class="mt-4 font-display text-2xl font-bold">No articles yet</h2>
        <p class="mt-2 text-muted">The first one is being written.</p>
      </section>
    ) : (
      <>
        <section class="mx-auto max-w-6xl px-5 py-16">
          <h2 class="reveal mb-7 font-display text-xs font-bold uppercase tracking-[0.2em] text-muted">
            Featured
          </h2>
          <PostCard post={featured} featured />
        </section>

        {recent.length > 0 && (
          <section class="mx-auto max-w-6xl px-5 pb-8">
            <div class="reveal mb-7 flex items-end justify-between">
              <h2 class="font-display text-xs font-bold uppercase tracking-[0.2em] text-muted">
                Latest
              </h2>
              <a
                href="/blog"
                class="text-sm font-semibold text-primary transition-opacity hover:opacity-75"
              >
                All articles →
              </a>
            </div>
            <div class="grid gap-5 sm:grid-cols-2">
              {recent.map((post) => (
                <PostCard post={post} />
              ))}
            </div>
          </section>
        )}

        {categories.length > 0 && (
          <section class="mx-auto max-w-6xl px-5 py-16">
            <h2 class="reveal mb-7 font-display text-xs font-bold uppercase tracking-[0.2em] text-muted">
              Topics
            </h2>
            <div class="reveal flex flex-wrap gap-3">
              {categories.map((c) => (
                <a
                  href="/blog"
                  class="rounded-xl border border-border bg-surface px-4 py-2.5 text-sm font-medium transition-all hover:-translate-y-0.5 hover:border-primary"
                >
                  {c.name}
                  <span class="ml-2 text-muted">{c.count}</span>
                </a>
              ))}
            </div>
          </section>
        )}
      </>
    )
  }
</BaseLayout>
