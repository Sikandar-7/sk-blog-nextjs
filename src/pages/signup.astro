---
import BaseLayout from '../layouts/BaseLayout.astro';
import AuthForm from '../components/islands/AuthForm.tsx';
---

<BaseLayout
  title="Create account"
  description="Join SK Blog and publish your own articles."
  noindex={true}
>
  <section class="mx-auto w-full max-w-md px-6 py-20 sm:py-28">
    <div class="reveal">
      <p class="mb-3 text-xs font-bold uppercase tracking-[0.2em] text-primary">Join in</p>
      <h1 class="mb-3 font-display text-4xl font-extrabold tracking-tight">Create account</h1>
      <p class="mb-8 text-muted">Free, and you can publish your first article straight away.</p>

      <AuthForm mode="signup" client:load />
    </div>
  </section>
</BaseLayout>
